# Generates a C++ header embedding all SPIR-V shaders found in SHADER_DIR.
# Invoked as: cmake -DSHADER_DIR=<dir> -DOUT=<header> -P EmbedShaders.cmake
file(GLOB SPV_FILES "${SHADER_DIR}/*.spv")
list(SORT SPV_FILES)

set(CONTENT "// Generated by cmake/EmbedShaders.cmake - do not edit.\n")
string(APPEND CONTENT "#pragma once\n#include <cstddef>\n#include <cstdint>\n#include <string>\n\n")
string(APPEND CONTENT "namespace ignis::shaders {\n\n")

set(ENTRIES "")
foreach(f ${SPV_FILES})
    get_filename_component(name "${f}" NAME_WE) # e.g. gbuffer_vert
    file(SIZE "${f}" SPV_SIZE)
    if(SPV_SIZE EQUAL 0)
        continue() # empty placeholder (no glslangValidator) - skip
    endif()
    file(READ "${f}" HEX HEX)
    # Group 8 hex chars (4 bytes) into one uint32_t SPIR-V word, little-endian:
    # bytes b0 b1 b2 b3 -> word 0x b3b2b1b0. CMake regex has no {n}, so match
    # four explicit byte pairs and reorder via backreferences.
    string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])([0-9a-fA-F][0-9a-fA-F])" "0x\\4\\3\\2\\1," HEX_ARRAY "${HEX}")
    string(APPEND CONTENT "static const uint32_t ${name}_spv[] = {${HEX_ARRAY}};\n")
    string(APPEND CONTENT "static const size_t ${name}_spv_words = sizeof(${name}_spv) / sizeof(uint32_t);\n\n")
    string(APPEND ENTRIES "    if (name == \"${name}\") { words = ${name}_spv_words; return ${name}_spv; }\n")
endforeach()

string(APPEND CONTENT "// Returns the SPIR-V words for a shader name (e.g. \"gbuffer_vert\") or nullptr.\n")
string(APPEND CONTENT "inline const uint32_t* find([[maybe_unused]] const std::string& name, size_t& words) {\n")
string(APPEND CONTENT "${ENTRIES}")
string(APPEND CONTENT "    words = 0;\n    return nullptr;\n}\n\n")
string(APPEND CONTENT "} // namespace ignis::shaders\n")

file(WRITE "${OUT}" "${CONTENT}")
